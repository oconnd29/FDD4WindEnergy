{
  "schema_version": 1,
  "title": "Tutorial — blade damage, Cost / Impact Optimisation",
  "created": "2026-09-02T11:09:14+00:00",
  "modified": "2026-09-02T11:09:14+00:00",
  "notes": "Synthetic onshore Irish 2 MW turbine. Primary objective is Cost / Impact: is sending a crew when the method flags the turbine cheaper than waiting until the blade fails? Early Warning is secondary so CARE is still reported. Power, residual and CUSUM are stored in the CSVs; the app only plots them and adds up the costs. The labelled interval is a pre-fault window ending when the blade fails.",
  "inputs": {
    "data_types": [
      "data_scada",
      "data_other_ts"
    ],
    "records": [
      "rec_expert"
    ],
    "cost_inputs": [
      "cost_dispatch",
      "cost_inspection",
      "cost_downtime",
      "cost_false_positive",
      "cost_other"
    ],
    "method": "method_ad",
    "method_notes": "Direct AD: one-sided CUSUM on the power residual versus a simple piecewise power curve (cut-in 3 m/s, rated 12 m/s, cut-out 25 m/s, 2 MW). Fixed HPs: k = 0.5, τ = 0.99 training quantile. Not recomputed in the software."
  },
  "stage1": {
    "primary_objective": "obj_cost",
    "secondary_objectives": [
      "obj_early_warning"
    ],
    "early_warning": {
      "reference_event": "Simulated blade-fault stop that ends the 28-day pre-fault window",
      "detection_point": "detect_fd_condition",
      "notes": "Secondary Early Warning: first time the persistence condition is met, not the first isolated residual alarm."
    },
    "maintenance": {
      "useful_lead_time": "",
      "acceptable_false_fd": "",
      "workload_unit": "",
      "notes": ""
    },
    "diagnostic": {
      "diagnostic_level": "",
      "notes": ""
    },
    "cost_impact": {
      "cost_terms": [
        "cost_dispatch",
        "cost_inspection",
        "cost_downtime",
        "cost_false_positive",
        "cost_other"
      ],
      "sensitivity_planned": true,
      "notes": "Euro values are tutorial assumptions for onshore Ireland, not a farm quote. Crane, access-track and H&S delay are omitted. Offshore vessel costs are out of scope.",
      "model": {
        "price_eur_per_mwh": 100.0,
        "inspection_eur": 4000.0,
        "planned_repair_eur": 12000.0,
        "planned_downtime_h": 24.0,
        "emergency_repair_eur": 50000.0,
        "emergency_downtime_h": 240.0,
        "rated_power_kw": 2000.0,
        "sample_hours": 0.16666666666666666,
        "notes": "€100/MWh sits between RESS 4 onshore-wind strike (€90.47/MWh) and recent SEM DAM averages (~€104/MWh in 2024, ~€114/MWh in 2025). RESS 5 wind ~€100.63/MWh. This is a constant selling-price assumption, not a contract. Crew visit €4,000 approximates an onshore rope-access call-out. Early repair €12,000 + 24 h is a limited leading-edge repair, not a blade swap. Repair after the blade fails €50,000 + 10 days follows the Wetzel/Sandia structural-repair order of magnitude, excluding crane."
      }
    }
  },
  "stage2": {
    "fault_definition": "Synthetic blade aerodynamic degradation (leading-edge style): region-2 power loss ramps from 0 to 5% over 28 days, then a simulated blade-fault stop. The labelled interval ends at that stop; it is not the faulted operating period.",
    "labelled_level": "Component (rotor blade). Not a specific damage mechanism.",
    "evidence_tier": "tier_c",
    "evidence_sources": [
      "rec_expert"
    ],
    "symptom_method": "symptom_rule",
    "label_representation": "label_interval",
    "uncertainty": {
      "evidence_certainty": "cert_categorical",
      "timing_certainty": "time_point",
      "source_agreement": "",
      "label_stability": ""
    },
    "healthy_case_evidence": "Matched healthy case: identical wind series, no damage, higher measurement noise throughout so CUSUM does not reach the persistence threshold.",
    "circular_risk": false,
    "notes": ""
  },
  "stage3": {
    "case_construction": "case_constructed",
    "case_notes": "One synthetic faulty case and one matched healthy case with the same wind.",
    "event_windows": {
      "defined": true,
      "window_kind": "window_prefault",
      "boundaries": "Last 28 days of the test period (4,032 ten-minute steps). The window ends at the simulated blade-fault stop; it is a pre-fault window, not a fault window.",
      "reference_event": "Simulated blade-fault stop (end of window)",
      "timing_rules": "Onset is known by construction: region-2 loss begins at window start and ramps linearly."
    },
    "comparison": "cmp_pairs",
    "data_periods": {
      "training": "First 288 samples (2 days).",
      "validation": "Next 72 samples (12 hours).",
      "test": "Final 35 days; 7 days of healthy test then a 28-day pre-fault window."
    },
    "valid_data_rules": "All synthetic samples are valid; no curtailment flags.",
    "tuning_mode": "tune_oracle",
    "tuning_inventory": "",
    "tuning_notes": "HPs are fixed for the tutorial, not tuned on this pair.",
    "fd_condition": "fd_persistence",
    "fd_condition_notes": "Criticality counter with κ = 72 (12 hours at 10-minute sampling), the C2C default. Detection time for the cost model is the first sample at which this condition is met."
  },
  "stage4": {
    "output_class": "out_binary",
    "output_score": "out_hard",
    "include_stability": "no_stability",
    "accepted_metrics": [
      "expected_cost",
      "false_fd_rate",
      "faulty_detection_rate",
      "warning_lead",
      "care",
      "care_c",
      "care_a",
      "care_r",
      "care_e"
    ],
    "rejected_metrics": [
      "cost_weighted_error"
    ],
    "override_notes": "The comparison is: send a crew when the method flags the turbine, versus wait until the blade fails and then repair. Cost-weighted error is rejected as a duplicate summary of the same euro values. CARE is kept because Early Warning is a secondary objective."
  },
  "case_data": {
    "faulty_csv": "tutorials/cost_blade_pair/faulty.csv",
    "healthy_csv": "tutorials/cost_blade_pair/healthy.csv",
    "kappa": 72,
    "notes": ""
  },
  "reproducibility": {
    "followed": [
      "data_source",
      "settings",
      "gt_provenance",
      "report"
    ],
    "skipped": [],
    "notes": "Euro values and the power-curve model are documented assumptions for this synthetic pair. Replace them with site values before treating the figures as operational."
  }
